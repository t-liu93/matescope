              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse"
      },
      "LoginInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput"
      },
      "MQTTInput": {
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[^\\s/@?#]*$",
            "title": "Host",
            "default": ""
          },
          "username": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\x00]*$",
            "title": "Username",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "default": false
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "default": 1883
          },
          "tls": {
            "type": "boolean",
            "title": "Tls",
            "default": false
          },
          "verify_tls": {
            "type": "boolean",
            "title": "Verify Tls",
            "default": true
          },
          "topic_prefix": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^+#\\x00\\r\\n]+$",
            "title": "Topic Prefix",
            "default": "teslamate"
          },
          "password": {
            "$ref": "#/components/schemas/PasswordChange"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MQTTInput"
      },
      "MQTTResponse": {
        "properties": {
          "password_set": {
            "type": "boolean",
            "title": "Password Set",
            "default": false
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "default": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "unconfigured",
              "unverified",
              "disabled",
              "skipped"
            ],
            "title": "Status",
            "default": "disabled"
          },
          "test_available": {
            "type": "boolean",
            "const": false,
            "title": "Test Available",
            "default": false
          },
          "host": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[^\\s/@?#]*$",
            "title": "Host",
            "default": ""
          },
          "username": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\x00]*$",
            "title": "Username",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "default": false
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "default": 1883
          },
          "tls": {
            "type": "boolean",
            "title": "Tls",
            "default": false
          },
          "verify_tls": {
            "type": "boolean",
            "title": "Verify Tls",
            "default": true
          },
          "topic_prefix": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^+#\\x00\\r\\n]+$",
            "title": "Topic Prefix",
            "default": "teslamate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MQTTResponse"
      },
      "Onboarding": {
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "preferences",
              "postgresql",
              "mqtt",
              "smtp",
              "review"
            ],
            "title": "Step",
            "default": "preferences"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Onboarding"
      },
      "PasswordChange": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "retain",
              "replace",
              "clear"
            ],
            "title": "Action",
            "default": "retain"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PasswordChange"
      },
      "PostgreSQLInput": {
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[^\\s/@?#]*$",
