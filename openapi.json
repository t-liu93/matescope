            "default": ""
          },
          "username": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[^\\r\\n\\x00]*$",
            "title": "Username",
            "default": ""
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "default": false
          },
          "port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "default": 5432
          },
          "database": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Database",
            "default": "teslamate"
          },
          "sslmode": {
            "type": "string",
            "enum": [
              "disable",
              "allow",
              "prefer",
              "require",
              "verify-ca",
              "verify-full"
