  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "csrf_token",
          "username"
        ],
        "title": "AuthResponse"
      },
      "ChangePasswordInput": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "format": "password",
            "title": "Current Password",
            "writeOnly": true
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "New Password",
            "writeOnly": true
          },
          "password_confirmation": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password Confirmation",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password",
          "password_confirmation"
        ],
        "title": "ChangePasswordInput"
      },
      "CreateAdminInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "password_confirmation": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "format": "password",
            "title": "Password Confirmation",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "password_confirmation"
        ],
        "title": "CreateAdminInput"
      },
      "CsrfResponse": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse"
      },
      "HTTPValidationError": {
        "properties": {
