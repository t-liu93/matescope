# Local configuration and credentials; keep sanitized examples trackable.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
secrets/
*.pem
*.key

# Python environments, builds, caches, and test output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Frontend dependencies, caches, and test output.
node_modules/
.pnpm-store/
.vite/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Runtime data and backups; never store production vehicle data here.
/data/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.backup
*.matescope.zip
*.log

# Machine-local agent state and scratch reports.
/.agents/
/.codex/
/.claude/
/review-notes/
/tmp/

# Editors and operating systems.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dependency lockfiles, migrations, generated API contracts, and synthetic
# fixtures belong in Git; do not add blanket ignore rules for them.
/development-notes/
