# Copy to .env.prod and replace the example values before deployment.
# 复制为 .env.prod，并在部署前替换示例值。
# Publication is pending; this placeholder is not an available release.
# 镜像发布尚未完成；此占位符不是可用版本。
MATESCOPE_IMAGE=ghcr.io/t-liu93/matescope:REPLACE_WITH_PUBLISHED_VERSION
# Prefer ghcr.io/t-liu93/matescope@sha256:<published-manifest-digest>.
# 建议使用 ghcr.io/t-liu93/matescope@sha256:<已发布清单摘要>。
TESLAMATE_NETWORK=REPLACE_WITH_EXISTING_NETWORK
MATESCOPE_PUBLIC_URL=https://matescope.example.com
MATESCOPE_PORT=8000
# Optional comma-separated immediate proxy IPs/CIDRs; never use *.
# 可选：以逗号分隔的直接代理 IP/CIDR；禁止使用 *。
MATESCOPE_TRUSTED_PROXIES=
